NODE_ENV=development

PORT=5000

N8N_ATTENDANCE_WEBHOOK_URL=https://n8n.bugopsx.in/webhook/Attendance-imp

# Database Connection (DATABASE_URL takes precedence if provided, e.g., Render Postgres)
DATABASE_URL=

# Individual Database Connection Parameters (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=attendance_db
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

ATTENDANCE_UPLOAD_MAX_MB=25

# Administrator Authentication Configuration
ADMIN_USERNAME=admin
# Generate bcrypt hash: node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 10))"
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
SESSION_MAX_AGE=86400

# Allowed Frontend Origins (Comma-separated or single URL)
ALLOWED_ORIGINS=https://attendance.bugopsx.in,http://localhost:5173
FRONTEND_URL=http://localhost:5173

