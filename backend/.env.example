PORT=5000
NODE_ENV=production

# Cross-Origin Resource Sharing (CORS) Configuration
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Database Configuration (Render PostgreSQL or external database)
DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host:5432/attendance_db
DB_SSL=true

# Optional n8n Webhook Endpoint
N8N_ATTENDANCE_WEBHOOK_URL=https://your-n8n-instance.com/webhook/Attendance-imp

# File Upload Configuration
ATTENDANCE_UPLOAD_MAX_MB=25

# Administrator Authentication Configuration
ADMIN_USERNAME=admin
# Generate bcrypt hash: node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 10))"
ADMIN_PASSWORD_HASH=$2b$10$YOUR_GENERATED_BCRYPT_HASH_HERE
SESSION_SECRET=your_random_secure_session_secret_key_here
SESSION_MAX_AGE=86400
