PORT=5000
N8N_ATTENDANCE_WEBHOOK_URL=https://your-n8n-instance.com/webhook/Attendance-imp

# Database Configuration
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/attendance_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=attendance_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# File Upload Configuration
ATTENDANCE_UPLOAD_MAX_MB=25

# Administrator Authentication Configuration
ADMIN_USERNAME=admin
# Generate bcrypt hash using: node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 10))"
ADMIN_PASSWORD_HASH=$2b$10$YOUR_GENERATED_BCRYPT_HASH_HERE
SESSION_SECRET=your_random_secure_session_secret_key_here
SESSION_MAX_AGE=86400
